# Copy this file to .env.local and fill in your values.

# ─── Frontend ───────────────────────────────────────────────────────────────
# Alchemy Starknet RPC key — used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
NEXT_PUBLIC_PROVIDER_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/EzO62qQ-wC9-OQyeOyL1y

# Deployed Shade auction contract address.
NEXT_PUBLIC_SHADE_ADDR=0x0
NEXT_PUBLIC_SHADE_CLASS_HASH=0x0

# (Optional) Echo/anonymizer helper deployed on Sepolia — enables the Echo
# action there. Leave as 0x0 if not deployed; you can deploy one from the Echo tab.
NEXT_PUBLIC_STRK20_ECHO_HELPER_SEPOLIA=0x0

# ─── Deploy script (scripts/deploy.ts) ──────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x_your_private_key
DEPLOYER_ADDRESS=0x_your_account_address
RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/your_key

# ─── Demo flow script (scripts/demo_flow.ts) ───────────────────────────────
SELLER_PRIVATE_KEY=0x_seller_key
SELLER_ADDRESS=0x_seller_address
BIDDER1_PRIVATE_KEY=0x_bidder1_key
BIDDER1_ADDRESS=0x_bidder1_address
BIDDER2_PRIVATE_KEY=0x_bidder2_key
BIDDER2_ADDRESS=0x_bidder2_address
BIDDER3_PRIVATE_KEY=0x_bidder3_key
BIDDER3_ADDRESS=0x_bidder3_address
SHADE_ADDR=0x_deployed_contract_address
STRK_TOKEN_ADDR=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
